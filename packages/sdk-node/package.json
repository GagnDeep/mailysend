{
  "name": "mailysend",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "The MailySend SDK and CLI. Resend-compatible, dependency-free, runs anywhere fetch does.",
  "homepage": "https://mailysend.com/docs#sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GagnDeep/mailysend.git",
    "directory": "packages/sdk-node"
  },
  "keywords": [
    "email",
    "mailysend",
    "resend",
    "resend-compatible",
    "transactional",
    "broadcast",
    "smtp",
    "cloudflare-workers",
    "self-hosted",
    "sdk"
  ],
  "bin": {
    "mailysend": "./dist/cli.js"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./compat": "./src/compat.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./compat": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@react-email/render": "*",
    "mjml": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    },
    "mjml": {
      "optional": true
    }
  },
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:js && pnpm run build:types",
    "build:cli": "pnpm --filter @mailysend/cli run build && node -e \"const f=require('node:fs');f.mkdirSync('dist',{recursive:true});f.copyFileSync('../../cli/dist/mailysend.js','dist/cli.js')\"",
    "build:js": "esbuild src/index.ts src/compat.ts --bundle --format=esm --platform=neutral --target=es2022 --outdir=dist --external:@react-email/render",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@mailysend/contracts": "workspace:*",
    "esbuild": "^0.28.2",
    "zod": "^4.5.4"
  },
  "bugs": {
    "url": "https://github.com/GagnDeep/mailysend/issues"
  }
}
