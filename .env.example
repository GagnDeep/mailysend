# ---------------------------------------------------------------------------
# MailySend
#
# Nothing here is required. Every value below has a working default, and the
# two that cannot be defaulted — the signing secret and the public URL — are
# generated and stored by the instance itself on first boot. A deployment with
# an empty environment comes up, migrates, creates its workspace and prints an
# API key.
#
# This file is also what the "Deploy to Cloudflare" flow reads to build its
# variables form, which is why it is short. Provider credentials are not here:
# they are configured in the dashboard, encrypted at rest, and never returned
# by the API. See docs/CONFIGURATION.md for the full list.
# ---------------------------------------------------------------------------

# 'single' for a self-hosted deployment, 'saas' for the hosted product.
MS_MODE=single

# Which transport sends when a workspace has configured none explicitly.
# cloudflare | ses | resend | smtp
MS_DEFAULT_PROVIDER=cloudflare

# Who owns this instance. Their first one-time sign-in code is written to the
# process log while no sending domain is verified yet — which is the only way
# into a brand-new deployment, since it cannot email anybody until then.
# Leave it blank and set it later; the code is printed either way.
MS_OWNER_EMAIL=

# 'off' stops writing a row per event and reconstructs message timelines from
# the object-store archive instead. Worth it above roughly 10M messages a month.
EVENT_DETAIL=on
