# ---------------------------------------------------------------------------
# MailySend — Node deployment (behind nginx, started by PM2)
#
# Copy to `.env` next to ecosystem.config.cjs. Nothing here is read on the
# Cloudflare target: there, the same values are Worker secrets and bindings.
# ---------------------------------------------------------------------------

# Signs tracking tokens, webhook signatures, reply addresses and session ids.
# Must be at least 32 characters; the server refuses to start in production
# without it, because a guessable secret makes every tracking pixel forgeable.
MS_SECRET=

# Encrypts stored provider credentials at rest (AES-GCM). Defaults to MS_SECRET
# when unset; set it separately if you ever want to rotate one without the other.
MS_DATA_KEY=

# 'single' for a self-hosted deployment, 'saas' for the hosted product.
MS_MODE=single

# Where the dashboard and the API live, and where tracking links point. The
# tracking host may differ (a separate Worker or subdomain) — if it does not,
# leave it equal to MS_PUBLIC_URL.
MS_PUBLIC_URL=https://mailysend.com
MS_TRACKING_URL=https://mailysend.com

# SQLite databases, the blob store and the queue spool. Anything on disk.
MS_DATA_DIR=./.data

# Which transport sends when a workspace has configured none explicitly.
# cloudflare | ses | resend | smtp
# --- dashboard sign-in -------------------------------------------------------
# Who owns this instance. Their first one-time code is printed to the process
# log while no sending domain is verified yet — which is the only way into a
# brand-new deployment, since it cannot email anybody until a domain is set up.
MS_OWNER_EMAIL=you@example.com

# Cloudflare Access, the intended sign-in path once the instance is real. Both
# must be set for the "Continue with Cloudflare Access" button to work; the
# assertion is verified against the team's published keys, never trusted.
# MS_ACCESS_TEAM=acme.cloudflareaccess.com
# MS_ACCESS_AUD=<the Access application's AUD tag>

MS_DEFAULT_PROVIDER=cloudflare

# --- Transports -------------------------------------------------------------
# Only the ones you intend to use need values. Credentials configured through
# the dashboard are stored encrypted in the database and take precedence over
# these; these exist so a fresh deployment can send before anyone logs in.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
