# ---------------------------------------------------------------------------
# MailySend
#
# Nothing here is required. Every value below has a working default, and the
# two that cannot be defaulted — the signing secret and the public URL — are
# generated and stored by the instance itself on first boot. A deployment with
# an empty environment comes up, migrates, creates its workspace and waits for
# somebody to claim it at /setup.
#
# This file is also what the "Deploy to Cloudflare" flow reads to build its
# variables form, which is why every key below ships with a value: that form
# shows key names only — never these comments — and stores each answer as a
# secret, so a key left empty here becomes a blank, masked, mandatory-looking
# box with nothing to explain it. Keys that have no sensible default belong in
# docs/CONFIGURATION.md and are set afterwards with `wrangler secret put`, not
# here — MS_OWNER_EMAIL and the MS_OIDC_* group are the ones that moved.
#
# Transport credentials are not here either: they are configured at
# Settings -> Transports, encrypted with AES-GCM at rest, and never returned by
# the API. See docs/CONFIGURATION.md for the full list, and docs/SENDING.md for
# what each transport actually needs.
# ---------------------------------------------------------------------------

# 'single' for a self-hosted deployment, 'saas' for the hosted product.
MS_MODE=single

# Which transport sends when a workspace has configured none explicitly, and
# has no credentials of its own here either. A domain can also be bound to one
# transport on its own page, which is what makes its DNS records right —
# unbound, they are the union across every transport this instance could fall
# back to. cloudflare | ses | resend | smtp
MS_DEFAULT_PROVIDER=cloudflare

# What the root path serves. 'app' (the default when MS_MODE=single) redirects
# / to your dashboard, or to /setup while the instance is unclaimed; the
# marketing pages and /docs stay reachable by URL. 'marketing' is what
# mailysend.com itself runs.
MS_LANDING=app

# 'off' stops writing a row per event and reconstructs message timelines from
# the object-store archive instead. Worth it above roughly 10M messages a month.
EVENT_DETAIL=on
