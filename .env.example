# ---------------------------------------------------------------------------
# MailySend
#
# Nothing here is required. Every value below has a working default, and the
# two that cannot be defaulted — the signing secret and the public URL — are
# generated and stored by the instance itself on first boot. A deployment with
# an empty environment comes up, migrates, creates its workspace and waits for
# somebody to claim it at /setup.
#
# This file is also what the "Deploy to Cloudflare" flow reads to build its
# variables form, which is why it is short. Transport credentials are not here:
# they are configured at Settings -> Transports, encrypted with AES-GCM at rest,
# and never returned by the API. See docs/CONFIGURATION.md for the full list,
# and docs/SENDING.md for what each transport actually needs.
# ---------------------------------------------------------------------------

# 'single' for a self-hosted deployment, 'saas' for the hosted product.
MS_MODE=single

# Which transport sends when a workspace has configured none explicitly, and
# has no credentials of its own here either. A domain can also be bound to one
# transport on its own page, which is what makes its DNS records right --
# unbound, they are the union across every transport this instance could fall
# back to. cloudflare | ses | resend | smtp
MS_DEFAULT_PROVIDER=cloudflare

# Optional, and restrictive rather than creative: it does NOT create an owner.
# A fresh deployment is claimed by whoever opens /setup first and registers a
# passkey. Set this to an email address and only that address may claim it —
# useful when the URL is public before you have had a chance to open it.
MS_OWNER_EMAIL=

# What the root path serves. 'app' (the default when MS_MODE=single) redirects
# / to your dashboard, or to /setup while the instance is unclaimed; the
# marketing pages and /docs stay reachable by URL. 'marketing' is what
# mailysend.com itself runs.
MS_LANDING=app

# Single sign-on, optional. All three must be set before the button appears on
# the sign-in page. Register ${MS_PUBLIC_URL}/v1/auth/oidc/callback as the
# redirect URI with your provider. See docs/AUTH.md.
MS_OIDC_ISSUER=
MS_OIDC_CLIENT_ID=
MS_OIDC_CLIENT_SECRET=
# Comma-separated email domains. Empty means any address the provider vouches
# for. MS_OIDC_AUTO_PROVISION=true enrols an unknown address on first sign-in
# and requires this allowlist; without it, only existing members can sign in.
MS_OIDC_ALLOWED_DOMAINS=
MS_OIDC_AUTO_PROVISION=false
# What the button says. Defaults to "single sign-on".
MS_OIDC_LABEL=

# 'off' stops writing a row per event and reconstructs message timelines from
# the object-store archive instead. Worth it above roughly 10M messages a month.
EVENT_DETAIL=on
